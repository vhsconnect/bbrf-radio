# copy to .env; make and docker compose read it

# host
STATE_DIR=${HOME}/.local/state/bbrf
NODE=bbrf
HOST_UID=1000
HOST_GID=100

# role: all, hub or ingest
BBRF_ROLE=all

# sync, ingest -> hub over Erlang distribution; unused on all
# SYNC_HUB_NODE=           ingest: e.g. bbrf_hub@192.168.50.121
# SYNC_INGEST_NODE=        hub: e.g. bbrf_ingest@192.168.50.178
SYNC_INTERVAL_HOURS=24
# on the hub, RETENTION_DAYS (below) is how much history it keeps, e.g. 30

# make secrets, on the admin machine only; unset ones are prompted for
# HUB_ADDR=
# INGEST_ADDR=
# HUB_AGE=                 from make age-key on the hub
# INGEST_AGE=              from make age-key on the ingest node

# components, 1 on / 0 off
PORT=4882
BBRF_API=1
BBRF_INGESTER=1
LOG_LEVEL=info

# database
JOURNAL_MODE=delete
DB_POOL_SIZE=5
DB_CACHE_KB=8000

# api
ITEMS_PER_PAGE=5000
TRACKS_PER_PAGE=200
FADER_VALUE=25

# ingester
FULL_SYNC_HOURS=168
PRUNE_HOURS=24
RETENTION_DAYS=365
REPORT_SECONDS=10
POLL_LIMIT=1000
CHANGES_POLL_MINUTES=10
CLICKS_POLL_MINUTES=360

# track ingestion: full-sweep or adaptive
TRACK_STRATEGY=full-sweep
TRACK_CYCLE_MINUTES=1
WAVE_CONCURRENCY=56
WAVE_DEADLINE_SECONDS=60
WAVE_MAX_STATIONS=10000

# full-sweep
SWEEP_CYCLE_MINUTES=60
SWEEP_RETRIES_PER_WAVE=500

# adaptive
DISCOVERY_PER_WAVE=500
ICY_INTERVAL_MINUTES=60
POPULAR_CLICKCOUNT=20

# external services
MUSICBRAINZ_BASE_URL=https://musicbrainz.org/ws/2
MUSICBRAINZ_INTERVAL_MS=1000
# RADIO_BROWSER_BASE_URL=   unset: a mirror is discovered over DNS

# differ between bare metal and the container, so set per environment:
# BBRF_DB=                  defaults to $STATE_DIR/db.sqlite
# STATIC_DIR=               make: repo root, container: /app/static
# FAVORITES_IMPORT_FILE=    make: ~/.config/bbrf-radio/storage.json, container: /import/bbrf-radio/storage.json
